// ============================================
// Prisma Schema - Portfolio Admin Panel
// ============================================
// 
// Documentación: https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference
// 
// Este schema define la estructura de la base de datos MySQL.
// Usa Prisma 6 (estable y probado con Next.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELO: User (Autenticación)
// ============================================
// 
// Almacena información de usuarios administradores.
// 
// NOTA sobre el ID (CUID):
// - CUID (Collision-resistant Unique Identifier) es un identificador único
// - No es un hash, es un ID seguro y único generado automáticamente
// - Formato: "clx..." (ejemplo: "clx123abc456")
// - Ventajas: seguro, único, ordenable, no predecible
// - Más información: https://github.com/paralleldrive/cuid
//
model User {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  name      String?  // Nombre completo del usuario (opcional)
  email     String   @unique // Email único para autenticación
  password  String   // Contraseña encriptada con bcrypt (10 rounds)
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([email]) // Índice para búsquedas rápidas por email
  @@map("users") // Nombre de la tabla en MySQL: "users"
}

// ============================================
// MODELO: SocialLink (Enlaces Sociales)
// ============================================
// 
// Almacena los enlaces a redes sociales del portfolio.
// Permite gestionar múltiples enlaces sociales con orden personalizado.
//
model SocialLink {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  label     String   // Nombre de la red social (ej: "GitHub", "LinkedIn")
  url       String   // URL completa del enlace (debe ser válida)
  icon      String   // Nombre del icono de react-icons (ej: "FaGithub", "FaLinkedin")
  order     Int      @default(0) // Orden de visualización (menor = primero)
  active    Boolean  @default(true) // Si el enlace está activo/visible
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar enlaces activos
  @@map("social_links") // Nombre de la tabla en MySQL: "social_links"
}

// ============================================
// MODELO: Article (Artículos)
// ============================================
// 
// Almacena los artículos del portfolio.
// Permite gestionar artículos publicados en diferentes plataformas (Medium, Dev.to, Hashnode, etc.).
//
model Article {
  id          String   @id @default(cuid()) // CUID: identificador único y seguro
  title       String   // Título del artículo
  description String   // Descripción/resumen del artículo
  url         String   @unique // URL completa del artículo (debe ser válida)
  image       String?  // URL de la imagen para el carrusel (opcional, ej: "/images/article-1.jpg")
  order       Int      @default(0) // Orden de visualización (menor = primero)
  active      Boolean  @default(true) // Si el artículo está activo/visible
  featured    Boolean  @default(false) // Si el artículo aparece en el carrusel del hero
  createdAt   DateTime @default(now()) // Timestamp de creación
  updatedAt   DateTime @updatedAt // Timestamp de última actualización

  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar artículos activos
  @@index([featured]) // Índice para filtrar artículos destacados (carrusel)
  @@index([url]) // Índice para búsquedas por URL (evitar duplicados)
  @@map("articles") // Nombre de la tabla en MySQL: "articles"
}

// ============================================
// MODELO: Technology (Tecnologías del About)
// ============================================
// 
// Almacena las tecnologías del About Section organizadas por categorías.
// Permite gestionar las tecnologías de Front-end, Styles, Back-end y DevOps.
//
model Technology {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  name      String   // Nombre de la tecnología (ej: "React", "TypeScript", "Docker")
  category  String   // Categoría: "frontend", "styles", "backend", "devops"
  order     Int      @default(0) // Orden de visualización dentro de la categoría (menor = primero)
  active    Boolean  @default(true) // Si la tecnología está activa/visible
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([category]) // Índice para filtrar por categoría
  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar tecnologías activas
  @@index([category, order]) // Índice compuesto para ordenar por categoría y orden
  @@map("technologies") // Nombre de la tabla en MySQL: "technologies"
}

// ============================================
// MODELO: WorkExperience (Experiencia Laboral)
// ============================================
// 
// Almacena la experiencia laboral del portfolio.
// Permite gestionar el historial de trabajo con periodos, duración, empresa y posición.
//
model WorkExperience {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  period    String   // Período de trabajo (ej: "2022 -", "2021 - 2022")
  duration  String   // Duración del trabajo (ej: "1 year 5 months", "8 months")
  company   String   // Nombre de la empresa (ej: "ITHUB", "VK Development Lab")
  position  String   // Posición o cargo (ej: "Frontend developer | React & Vue")
  order     Int      @default(0) // Orden de visualización (menor = primero, más reciente arriba)
  active    Boolean  @default(true) // Si la experiencia está activa/visible
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar experiencias activas
  @@map("work_experiences") // Nombre de la tabla en MySQL: "work_experiences"
}

// ============================================
// MODELO: Project (Proyectos del Portfolio)
// ============================================
// 
// Almacena los proyectos del portfolio.
// Permite gestionar proyectos con imágenes, tags, descripciones y enlaces.
//
model Project {
  id          String   @id @default(cuid()) // CUID: identificador único y seguro
  title       String   // Título del proyecto
  description String   @db.Text // Descripción del proyecto (puede contener markdown)
  image       String   // URL de la imagen principal (ej: "/images/img2.jpg")
  images      Json?    // Array opcional de imágenes para collage (JSON: ["/images/rojo.jpg", ...])
  tags        Json     // Array de tags/tecnologías (JSON: ["Golang", "TypeScript", ...])
  demoUrl     String?  // URL del demo del proyecto (opcional)
  githubUrl  String?  // URL del repositorio GitHub (opcional)
  order       Int      @default(0) // Orden de visualización (menor = primero)
  collageType String   @default("first") // Tipo de collage: "first", "second", "third"
  active      Boolean  @default(true) // Si el proyecto está activo/visible
  createdAt   DateTime @default(now()) // Timestamp de creación
  updatedAt   DateTime @updatedAt // Timestamp de última actualización

  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar proyectos activos
  @@map("projects") // Nombre de la tabla en MySQL: "projects"
}

// ============================================
// MODELO: AboutMe (Información del About Me)
// ============================================
// 
// Almacena la información del About Me section.
// Modelo singleton: solo debe haber un registro activo.
// Permite gestionar la imagen de perfil y otros datos del About Me.
//
model AboutMe {
  id          String   @id @default(cuid()) // CUID: identificador único y seguro
  profileImage String?  // Ruta de la imagen de perfil (ej: "/images/profile.jpg")
  createdAt   DateTime @default(now()) // Timestamp de creación
  updatedAt   DateTime @updatedAt // Timestamp de última actualización

  @@map("about_me") // Nombre de la tabla en MySQL: "about_me"
}
