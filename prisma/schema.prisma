// ============================================
// Prisma Schema - Portfolio Admin Panel
// ============================================
// 
// Documentación: https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference
// 
// Este schema define la estructura de la base de datos MySQL.
// Usa Prisma 6 (estable y probado con Next.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELO: User (Autenticación)
// ============================================
// 
// Almacena información de usuarios administradores.
// 
// NOTA sobre el ID (CUID):
// - CUID (Collision-resistant Unique Identifier) es un identificador único
// - No es un hash, es un ID seguro y único generado automáticamente
// - Formato: "clx..." (ejemplo: "clx123abc456")
// - Ventajas: seguro, único, ordenable, no predecible
// - Más información: https://github.com/paralleldrive/cuid
//
model User {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  name      String?  // Nombre completo del usuario (opcional)
  email     String   @unique // Email único para autenticación
  password  String   // Contraseña encriptada con bcrypt (10 rounds)
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([email]) // Índice para búsquedas rápidas por email
  @@map("users") // Nombre de la tabla en MySQL: "users"
}

// ============================================
// MODELO: SocialLink (Enlaces Sociales)
// ============================================
// 
// Almacena los enlaces a redes sociales del portfolio.
// Permite gestionar múltiples enlaces sociales con orden personalizado.
//
model SocialLink {
  id        String   @id @default(cuid()) // CUID: identificador único y seguro
  label     String   // Nombre de la red social (ej: "GitHub", "LinkedIn")
  url       String   // URL completa del enlace (debe ser válida)
  icon      String   // Nombre del icono de react-icons (ej: "FaGithub", "FaLinkedin")
  order     Int      @default(0) // Orden de visualización (menor = primero)
  active    Boolean  @default(true) // Si el enlace está activo/visible
  createdAt DateTime @default(now()) // Timestamp de creación
  updatedAt DateTime @updatedAt // Timestamp de última actualización

  @@index([order]) // Índice para ordenar rápidamente
  @@index([active]) // Índice para filtrar enlaces activos
  @@map("social_links") // Nombre de la tabla en MySQL: "social_links"
}
